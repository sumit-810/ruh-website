{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product.html",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "(?<p>[a-z0-9-]+)"
        }
      ],
      "destination": "/products/:p",
      "permanent": true
    },
    {
      "source": "/collection.html",
      "has": [
        {
          "type": "query",
          "key": "c",
          "value": "(?<c>[a-z0-9-]+)"
        }
      ],
      "destination": "/collections/:c",
      "permanent": true
    },
    {
      "source": "/article.html",
      "has": [
        {
          "type": "query",
          "key": "a",
          "value": "(?<a>[a-z0-9-]+)"
        }
      ],
      "destination": "/journal/:a",
      "permanent": true
    },
    {
      "source": "/:page(shop|story|journal|contact|faq|shipping-returns|privacy|terms|search|checkout|order).html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(img|brand)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
